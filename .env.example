# Copy to .env (never commit real values). ASP.NET Core reads these as configuration (double underscore = section).
ASPNETCORE_ENVIRONMENT=Production
ConnectionStrings__RiseUp=Server=sql;Database=RiseUp;User Id=riseup_app;Password=<from-secret-store>;TrustServerCertificate=False;Encrypt=True
Database__Provider=SqlServer
Database__InitializeOnStartup=false
# Set the public site origin before enabling mail or hosted checkout.
Site__PublicOrigin=https://riseup.example
Registration__Enabled=false
Email__Enabled=false
Email__Smtp__Host=
Email__Smtp__Port=587
Email__Smtp__From=
Email__Smtp__Username=
Email__Smtp__Password=
# Choose Disabled or SSLCOMMERZ. Use TestMode=true only with a provider test store in staging.
Payments__Gateway=Disabled
Payments__SslCommerz__TestMode=false
Payments__SslCommerz__StoreId=
Payments__SslCommerz__StorePassword=
# The AI sandbox runs locally with the default settings.
Storage__RootPath=/var/riseup/private
Mfa__AllowDemoCodes=false
Jobs__Enabled=true
RateLimits__AuthPerMinute=20
