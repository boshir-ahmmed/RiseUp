<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!-- Style-only rules suppressed; security and reliability analyzers stay on. -->
    <NoWarn>$(NoWarn);CA1848;CA1716;CA1711;CA1819;CA2007;CA1062;CA1031;CA1303;CA1724;CA1725;CA1861;CA1305;CA1310;CA1873;CA1826;CA1822</NoWarn>
  </PropertyGroup>
</Project>
