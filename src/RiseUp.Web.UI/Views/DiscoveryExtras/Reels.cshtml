@model ReelsViewModel
@{
    ViewData["Title"] = "Reels";
    var actor = CurrentActor.From(User);
    Layout = actor.IsAuthenticated ? "_AppLayout" : "_Layout";
    var canInteract = actor.IsFounder || actor.IsInvestor;
    var reels = Model.Reels.Where(r => r.VideoUrl is not null).ToList();
    var total = reels.Count + Model.Teasers.Count;
}
<section class="reels-view" aria-labelledby="reels-title">
    <header class="reels-head">
        <h1 id="reels-title">Reels</h1>
        @if (total > 0)
        {
            <nav class="reel-pager" aria-label="Reel navigation" hidden>
                <output aria-label="Reel position">1 / @total</output>
                <button type="button" data-step="-1" aria-label="Previous reel" aria-controls="reels-stream" disabled>↑</button>
                <button type="button" data-step="1" aria-label="Next reel" aria-controls="reels-stream">↓</button>
            </nav>
        }
    </header>
    @if (total == 0) { <p class="empty">No reels yet.</p> }
    else
    {
        <div id="reels-stream" class="reels-stream" tabindex="0" role="region" aria-label="Reel player">
            @foreach (var reel in reels)
            {
                <article class="reel-slide" id="reel-@reel.Id" aria-label="@reel.Title">
                    <div class="reel-scene">
                        <div class="reel-screen">
                            <video src="@reel.VideoUrl" poster="@reel.PosterUrl" aria-label="@reel.Title" controls muted loop playsinline preload="none" data-feedvideo></video>
                        </div>
                        <div class="reel-caption">
                            @if (reel.IsPromoted) { <span class="badge b-promo">Promoted</span> }
                            <a class="reel-author" href="/startups/@reel.StartupId?tab=reels"><partial name="_Brand" model="(reel.StartupName, reel.ColorIndex, string.Empty, reel.LogoUrl)" />@reel.StartupName</a>
                            <h2><a href="/posts/@reel.Id">@reel.Title</a></h2>
                            @if (!string.IsNullOrWhiteSpace(reel.Body)) { <div class="reel-description"><partial name="_ReadMore" model="(reel.Body, 110)" /></div> }
                        </div>
                        <div class="reel-actions" role="group" aria-label="Reel actions">
                            <button type="button" data-like="@reel.Id" data-can="@(canInteract ? "1" : "0")" aria-label="Like reel" aria-pressed="@(reel.LikedByMe ? "true" : "false")"><partial name="_Icon" model='"heart"' /><span data-likes="@reel.Id">@reel.Likes</span></button>
                            <a href="/posts/@reel.Id#comments" aria-label="@reel.Comments comments"><partial name="_Icon" model='"cmt"' /><span>@reel.Comments</span></a>
                            @if (canInteract) { <button type="button" data-save="@reel.Id" aria-pressed="@(reel.SavedByMe ? "true" : "false")"><partial name="_Icon" model='"save"' /><span>@(reel.SavedByMe ? "Saved" : "Save")</span></button> }
                            <button type="button" data-share="@reel.Id" data-can="@(canInteract ? "1" : "0")"><partial name="_Icon" model='"share"' /><span>Share</span></button>
                        </div>
                    </div>
                </article>
            }
            @foreach (var s in Model.Teasers)
            {
                <article class="reel-slide" id="s-@s.StartupId" aria-label="@s.Name teaser">
                    <div class="reel-scene">
                        <div class="reel-screen"><video src="@s.Teaser.Url" poster="@s.Teaser.PosterUrl" aria-label="@s.Name teaser" controls muted loop playsinline preload="none" data-feedvideo></video></div>
                        <div class="reel-caption">
                            <a class="reel-author" href="/startups/@s.StartupId"><partial name="_Brand" model="(s.Name, s.ColorIndex, string.Empty, s.LogoUrl)" />@s.Name</a>
                            <h2>@s.Tagline</h2>
                            <p class="reel-description">Pitch teaser · @s.Industry · @Ui.Stage(s.Stage) · @s.Location</p>
                            <div class="row reel-links">
                                @if (s.ViewerIsVerifiedInvestor)
                                {
                                    if (s.PendingPitchRequestId is int rid) { <a class="btn btn-primary btn-sm" href="/pitch-room/@rid">Open pitch room</a> }
                                    else if (s.Connected) { <span class="badge b-ver">Connected</span> <a class="btn btn-primary btn-sm" href="/conversations">Message</a> }
                                    else if (s.InvitationPending) { <span class="badge b-pend">Invitation pending</span> }
                                    else { <form method="post" action="/startups/@s.StartupId/invite" class="inline" asp-antiforgery="true"><input type="hidden" name="idempotencyKey" value="@Guid.NewGuid().ToString("N")" /><input type="hidden" name="note" value="I'd like to see your full pitch." /><button class="btn btn-primary btn-sm">Invite to connect</button></form> }
                                }
                                else if (!actor.IsAuthenticated) { <a class="btn btn-primary btn-sm" href="/register">Join to watch the full pitch</a> }
                                @if (s.Demo is not null) { <a class="btn btn-outline btn-sm" href="@s.Demo.Url" target="_blank" rel="noopener">Watch product demo</a> }
                            </div>
                        </div>
                    </div>
                </article>
            }
        </div>
    }
</section>
@section Scripts { <script src="~/js/pages/reels.js" asp-append-version="true" type="module"></script> }
