@model ReelsViewModel
@{
    ViewData["Title"] = "Reels";
    var actor = CurrentActor.From(User);
    Layout = actor.IsAuthenticated ? "_AppLayout" : "_Layout";
}
<div class="@(actor.IsAuthenticated ? "" : "container")" style="max-width:720px;@(actor.IsAuthenticated ? "" : "padding-top:24px;padding-bottom:48px")">
    <div class="page-h"><div><h1>Reels</h1><p>Watch short videos from the RiseUp community.</p></div><a class="btn btn-ghost btn-sm" href="/">← Feed</a></div>
    @if (!actor.IsAuthenticated) { <div class="notice n-info" style="margin-bottom:14px;display:block"><a href="/register">Join</a> as a verified investor to request full pitches and see each startup's ask.</div> }
    @foreach (var reel in Model.Reels)
    {
        <article class="card discover-reel" id="reel-@reel.Id">
            <div class="portrait-frame"><video src="@reel.VideoUrl" poster="@reel.PosterUrl" controls playsinline preload="metadata" aria-label="@reel.Title"></video></div>
            <div class="card-b">@if (reel.IsPromoted) {<span class="badge b-promo">Promoted</span>}
                <h2><a href="/posts/@reel.Id">@reel.Title</a></h2>
                <a href="/startups/@reel.StartupId?tab=reels">@reel.StartupName</a>
                <p class="mt8"><partial name="_ReadMore" model="(reel.Body, 180)" /></p>
            </div>
        </article>
    }
    @if (Model.Teasers.Count == 0 && Model.Reels.Count == 0) { <div class="card"><div class="empty">No reels yet.</div></div> }
    @foreach (var s in Model.Teasers)
    {
        <article class="ig card discover-reel" id="s-@s.StartupId">
            <div class="portrait-frame"><video src="@s.Teaser.Url" poster="@s.Teaser.PosterUrl" controls muted playsinline preload="none" data-feedvideo class="ig-img" aria-label="@s.Name teaser"></video><span class="ig-cat" style="background:rgba(0,0,0,.55);color:#fff;display:block">Teaser · @(s.Teaser.Seconds / 60):@((s.Teaser.Seconds % 60).ToString("00"))</span></div>
            <div class="ig-body" style="padding:12px 16px 16px">
                <div class="row" style="flex-wrap:nowrap"><partial name="_Brand" model="(s.Name, s.ColorIndex, string.Empty, s.LogoUrl)" /><div style="flex:1;min-width:0"><a href="/startups/@s.StartupId" class="ig-name">@s.Name</a> <span class="vtick">✓</span><div class="tiny muted">@s.Industry · @Ui.Stage(s.Stage) · @s.Location</div></div></div>
                <p class="small mt8">@s.Tagline</p>
                <div class="row mt8">
                    @if (s.ViewerIsVerifiedInvestor)
                    {
                        if (s.PendingPitchRequestId is int rid) { <a class="btn btn-primary btn-sm" href="/pitch-room/@rid">Open pitch room</a> }
                        else if (s.Connected) { <span class="badge b-ver">Connected</span> <a class="btn btn-primary btn-sm" href="/conversations">Message</a> }
                        else if (s.InvitationPending) { <span class="badge b-pend">Invitation pending</span> }
                        else { <form method="post" action="/startups/@s.StartupId/invite" class="inline" asp-antiforgery="true"><input type="hidden" name="idempotencyKey" value="@Guid.NewGuid().ToString("N")" /><input type="hidden" name="note" value="I'd like to see your full pitch." /><button class="btn btn-primary btn-sm">Invite to connect</button></form> }
                    }
                    else if (!actor.IsAuthenticated) { <a class="btn btn-primary btn-sm" href="/register">Join to watch the full pitch</a> }
                    @if (s.Demo is not null) { <a class="btn btn-outline btn-sm" href="@s.Demo.Url" target="_blank" rel="noopener">Watch product demo</a> }
                    <a class="btn btn-ghost btn-sm" href="/startups/@s.StartupId">View details</a>
                </div>
            </div>
        </article>
    }
</div>
