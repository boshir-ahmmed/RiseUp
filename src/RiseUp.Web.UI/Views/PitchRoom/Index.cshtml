@model PitchRoomDto
@{
    ViewData["Title"] = $"{Model.StartupName} — pitch room";
    Layout = "_AppLayout";
    var p = Model.Package;
    var pending = Model.Status == RequestStatus.Pending;
    (double At, string Label)[] chapters = [(0, "Intro"), (3, "Founder"), (6.5, "Problem"), (10.5, "Solution"), (14, "Product"), (18, "Traction"), (21.5, "The ask"), (26, "Close")];
    var watermark = Model.ViewerIsInvestor ? $"Shared with {Model.InvestorName} · RiseUp · {DateTime.UtcNow:dd MMM yyyy}" : "Preview · RiseUp";
}
<div data-room="@(Model.RequestId ?? 0)" data-track="@(Model.ViewerIsInvestor ? "1" : "0")"></div>
<div class="room-hero" style="--pc:@Ui.Color(Model.ColorIndex)">
    <a href="@(Model.ViewerIsInvestor ? "/requests" : "/pitches?tab=sent")" class="small">← @(Model.ViewerIsInvestor ? "Pitches & invitations" : "Pitch Studio")</a>
    <div class="rh-row">
        <div class="row" style="flex-wrap:nowrap;gap:16px;align-items:center"><partial name="_Brand" model="(Model.StartupName, Model.ColorIndex, string.Empty, Model.LogoUrl)" />
            <div style="min-width:0"><div class="rh-k">PITCH ROOM · @(Model.IsPreview ? "PREVIEW" : $"PACKAGE V{Model.SentVersion ?? Model.CurrentVersion}")</div><h1>@Model.StartupName</h1><p>@Model.Tagline</p>
                <div class="row" style="gap:6px"><span class="chip">@Model.Industry</span><span class="chip">@Ui.Stage(Model.Stage)</span><span class="chip">@Model.Location</span>@if (Model.StartupVerified) {<span class="badge b-ver">✓ Verified Startup</span>}</div></div></div>
        <div class="rh-side">
            <div class="rh-ask"><span>Raising</span><b>@Ui.Usd(p.Ask.AmountUsd)</b><small>@p.Ask.InstrumentLabel</small></div>
            <div class="row">
                @if (Model.Status is RequestStatus st) { <span class="rh-status"><span class="badge @Ui.StatusClass(st.ToString())">@st</span>@if (pending && Model.ExpiresAtUtc is DateTime ex) {<span class="tiny" style="margin-left:6px;color:var(--warn)">Expires in @Ui.Left(ex - DateTime.UtcNow)</span>}</span> }
                else { <span class="rh-status tiny">Preview — exactly what an investor sees</span> }
                @if (Model.ViewerIsInvestor) { <form method="post" action="/shortlist/@Model.StartupId/toggle" class="inline" asp-antiforgery="true"><button class="btn btn-outline btn-sm">@(Model.Shortlisted ? "★ Shortlisted" : "☆ Shortlist")</button></form> }
                <a class="btn btn-ghost btn-sm" href="/startups/@Model.StartupId">View profile</a>
            </div>
        </div>
    </div>
    <div class="rh-meta">@if (Model.SentAtUtc is DateTime sent) {<text>@(Model.ViewerIsInvestor ? "Sent to you" : $"Sent to {Model.InvestorName}") @Ui.Dhaka(sent)</text>@if (Model.SentVersion is int sv && sv != Model.CurrentVersion) {<text> · package updated since (now v@Model.CurrentVersion)</text>}} else {<text>Your current pitch package</text>}</div>
</div>
@if (Model.StartupSuspended) { <div class="notice n-danger" style="margin-bottom:16px">This startup account is suspended. The pitch room is read-only.</div> }
@if (Model.Status is RequestStatus.Accepted) { <div class="notice n-ok" style="margin-bottom:16px">This pitch was accepted — you are connected. Continue in your <a href="/conversations/@Model.ConversationId">conversation</a>.</div> }
else if (Model.Status is RequestStatus.Rejected or RequestStatus.Expired or RequestStatus.Cancelled) { <div class="notice n-warn" style="margin-bottom:16px">This pitch is @Model.Status.ToString()!.ToLowerInvariant().</div> }
@if (Model.Stats is { } stats)
{
    <div class="grid g4" style="margin-bottom:16px">
        <div class="card kpi"><div class="l">Opened</div><div class="v" style="font-size:18px">@(stats.OpenedAtUtc is DateTime o ? "Yes · " + Ui.Ago(o) : "Not yet")</div></div>
        <div class="card kpi"><div class="l">Pitch video watched</div><div class="v">@stats.PitchWatch%</div><div class="tiny muted">demo @stats.DemoWatch%</div></div>
        <div class="card kpi"><div class="l">Deck slides viewed</div><div class="v">@stats.SlidesViewed/@p.Slides.Count</div></div>
        <div class="card kpi"><div class="l">Documents viewed</div><div class="v">@stats.DocsViewed/@p.Documents.Count</div></div>
    </div>
}
<div class="grid room" style="align-items:start">
    <div class="stack">
        <div class="card"><div class="card-h"><div class="tabs" style="margin:0;border:0"><button type="button" class="on" data-vtab="pitch">Investor pitch@(p.Pitch is null ? "" : $" · {p.Pitch.Seconds / 60}:{p.Pitch.Seconds % 60:00}")</button><button type="button" data-vtab="demo">Product demo@(p.Demo is null ? "" : $" · {p.Demo.Seconds / 60}:{p.Demo.Seconds % 60:00}")</button></div>@if (Model.ViewerIsInvestor) {<span class="tiny muted">Watching is shared with the founder as pitch analytics</span>}</div>
            <div class="card-b">
                <div data-vpane="pitch">
                    @if (p.Pitch is not null)
                    {
                        <div class="vp"><video id="v-pitch" src="@p.Pitch.Url" poster="@p.Pitch.PosterUrl" controls playsinline preload="metadata" data-slot="Pitch"></video>
                            <div class="chapters">@foreach (var c in chapters.Where(c => c.At < p.Pitch.Seconds)) {<button type="button" class="chip x" data-seek="@c.At" data-target="v-pitch">@((int)c.At / 60):@(((int)c.At % 60).ToString("00")) @c.Label</button>}</div>
                            @if (p.Captions) {<div class="tiny muted mt8">CC available (Bangla / English) · streamed, not downloadable</div>}</div>
                    }
                    else { <div class="lock" style="aspect-ratio:16/9;display:grid;place-items:center">No pitch video uploaded yet</div> }
                </div>
                <div data-vpane="demo" hidden>
                    @if (p.Demo is not null) { <div class="vp"><video src="@p.Demo.Url" poster="@p.Demo.PosterUrl" controls playsinline preload="metadata" data-slot="Demo"></video></div> }
                    else { <div class="lock" style="aspect-ratio:16/9;display:grid;place-items:center">No product demo uploaded yet</div> }
                </div>
            </div></div>
        <div class="card"><div class="card-h"><h3>Pitch deck</h3><span class="tiny muted">In-app viewer · watermarked · no download</span></div>
            <div class="card-b">
                @if (p.Slides.Count == 0) { <div class="lock">No deck yet</div> }
                else
                {
                    <div class="deck" data-deck>
                        @for (var i = 0; i < p.Slides.Count; i++)
                        {
                            <div class="slide" hidden="@(i != 0)" style="background:linear-gradient(150deg,@Ui.Color(Model.ColorIndex) 0%,#101828 140%)"><div class="sl-k">@(i + 1) / @p.Slides.Count</div><div class="sl-t">@p.Slides[i].Title</div><div class="sl-b">@p.Slides[i].Body</div><div class="wm">@watermark</div></div>
                        }
                        <div class="row between mt8"><button type="button" class="btn btn-outline btn-sm" data-slide="prev" disabled>‹ Prev</button>
                            <div class="thumbs">@for (var i = 0; i < p.Slides.Count; i++) {<button type="button" class="th @(i == 0 ? "on" : "")" data-slide="@i" title="@p.Slides[i].Title" aria-label="Slide @(i + 1)"></button>}</div>
                            <button type="button" class="btn btn-outline btn-sm" data-slide="next" disabled="@(p.Slides.Count < 2)">Next ›</button></div>
                    </div>
                }
            </div></div>
        <div class="card"><div class="card-h"><h3>Pitch documents · @p.Documents.Count</h3></div>
            <div class="card-b">
                @foreach (var d in p.Documents)
                {
                    <div class="row between" style="padding:10px 0;border-bottom:1px solid #EEF2F6"><div style="min-width:0"><strong class="small">@d.FileName</strong><div class="tiny muted">@d.Label · @((d.SizeBytes / 1024.0).ToString("0")) KB · scanned ✓ · @(d.AllowDownload ? "download enabled" : "view only")</div></div>
                        <div class="row" style="gap:4px"><a class="btn btn-outline btn-sm" href="@d.Url" target="_blank" rel="noopener" data-doc="@d.Id">View</a>@if (d.AllowDownload) {<a class="btn btn-ghost btn-sm" href="@(d.Url)?download=true" data-doc="@d.Id">Download</a>}</div></div>
                }
                @if (p.Documents.Count == 0) { <p class="small muted mb0">No documents were attached to this pitch.</p> }
                <p class="tiny muted mt8 mb0">Views and downloads are logged. Full due-diligence files live in the Confidential Library after connection.</p>
            </div></div>
        @if (!Model.IsPreview)
        {
            <div class="card" id="qa"><div class="card-h"><h3>Questions &amp; answers · @Model.Questions.Count/@BusinessRules.PitchQuestionsMax</h3><span class="tiny muted">Private to this pitch · never read by AI</span></div>
                <div class="card-b">
                    @foreach (var q in Model.Questions)
                    {
                        <div class="qa"><div class="small"><strong>@q.AskerName</strong> <span class="muted">· @Ui.Ago(q.AtUtc)</span></div><div class="small">@q.Text</div>
                            @if (q.Answer is not null) { <div class="qa-a small"><strong>@Model.StartupName</strong> <span class="muted">· @Ui.Ago(q.AnsweredAtUtc!.Value)</span><br />@q.Answer</div> }
                            else if (Model.CanAnswer) { <form method="post" action="/pitch-questions/@q.Id/answer" class="row mt8" style="flex-wrap:nowrap" asp-antiforgery="true"><input type="hidden" name="requestId" value="@Model.RequestId" /><input class="input" name="text" maxlength="600" required placeholder="Answer this question" /><button class="btn btn-dark btn-sm">Answer</button></form> }
                            else { <div class="tiny muted mt8">Awaiting the founder's answer</div> }</div>
                    }
                    @if (Model.Questions.Count == 0) { <p class="small muted">No questions yet.</p> }
                    @if (Model.CanAsk) { <form method="post" action="/pitch-room/@Model.RequestId/questions" class="row mt8" style="flex-wrap:nowrap" asp-antiforgery="true"><input class="input" name="text" maxlength="300" required placeholder="Ask the founder a question (@Model.QuestionsLeft left)" /><button class="btn btn-dark btn-sm">Ask</button></form> }
                    else if (Model.ViewerIsInvestor && pending) { <p class="tiny muted">You've used all @BusinessRules.PitchQuestionsMax questions for this pitch.</p> }
                </div></div>
        }
    </div>
    <div class="stack">
        <div class="card card-b"><h3>The ask</h3><div class="stat" style="font-size:26px;font-weight:800">@Ui.Usd(p.Ask.AmountUsd)</div><div class="small muted">@p.Ask.InstrumentLabel · @p.Ask.Terms</div>
            <dl class="kv mt16" style="grid-template-columns:1fr auto"><dt>Minimum ticket</dt><dd>@Ui.Usd(p.Ask.MinTicketUsd)</dd><dt>Runway after raise</dt><dd>@p.Ask.RunwayMonths months</dd></dl>
            <div class="mt16"><div class="tiny muted" style="margin-bottom:6px">Use of funds</div>@foreach (var u in p.Ask.UseOfFunds) {<div class="small">@u.Label · @u.Percent%<div class="bar mt8" style="margin-bottom:8px"><i style="width:@(u.Percent)%"></i></div></div>}</div>
            <p class="tiny muted mb0">Founder-stated. RiseUp does not verify financial projections or facilitate the investment.</p></div>
        @if (Model.Note is not null) { <div class="card card-b"><h3>Founder's note</h3><p class="small" style="white-space:pre-wrap">@Model.Note</p>@if (Model.InfoRequest is not null) {<div class="notice n-info small" style="display:block">More information requested @Ui.Ago(Model.InfoRequestedAtUtc!.Value): “@Model.InfoRequest”</div>}</div> }
        <div class="card card-b"><h3>Highlights</h3><ul class="pk-hl">@foreach (var h in p.Highlights) {<li>@h</li>}</ul>@if (p.Highlights.Count == 0) {<p class="small muted mb0">None yet</p>}</div>
        <div class="card card-b"><h3>Team</h3>@foreach (var t in p.Team) {<div class="row" style="padding:6px 0;flex-wrap:nowrap"><partial name="_Avatar" model="(t.Name, (string?)null, Model.ColorIndex, 36)" /><div><strong class="small">@t.Name</strong><div class="tiny muted">@t.Role</div></div></div>}</div>
        @if (p.Faq.Count > 0) { <div class="card card-b"><h3>FAQ</h3>@foreach (var f in p.Faq) {<details class="small" style="padding:6px 0;border-bottom:1px solid #EEF2F6"><summary>@f.Question</summary><p class="muted mt8 mb0">@f.Answer</p></details>}</div> }
        @if (Model.CanDecide)
        {
            <div class="card card-b" style="border-color:var(--teal)"><h3>Your decision</h3><p class="tiny muted">Decide within @Ui.Left(Model.ExpiresAtUtc!.Value - DateTime.UtcNow). Declining starts the founder's 14-day cooldown. The founder’s credit was spent when this pitch was delivered.</p>
                <div class="stack">
                    <form method="post" action="/pitch-room/@Model.RequestId/respond" asp-antiforgery="true"><input type="hidden" name="accept" value="true" /><button class="btn btn-primary" style="width:100%">Accept &amp; open conversation</button></form>
                    <details><summary class="btn btn-outline" style="width:100%">Request more information</summary><form method="post" action="/pitch-room/@Model.RequestId/more-info" class="stack mt8" asp-antiforgery="true"><textarea class="input" name="message" rows="3" maxlength="500" required placeholder="What would help you decide?"></textarea><p class="tiny muted mb0">This does not pause the 14-day decision window.</p><button class="btn btn-dark btn-sm">Send request</button></form></details>
                    <form method="post" action="/pitch-room/@Model.RequestId/respond" asp-antiforgery="true"><input type="hidden" name="accept" value="false" /><button class="btn btn-danger" style="width:100%" data-confirm="Decline? The founder can send a new pitch only 14 days after the original send time.">Decline</button></form>
                </div></div>
        }
        @if (Model.ViewerIsInvestor && Model.Status == RequestStatus.Accepted && Model.ConversationId is int cid) { <div class="card card-b"><h3>Next step</h3><a class="btn btn-primary" style="width:100%" href="/conversations/@cid#meetings">Open conversation &amp; propose a meeting</a></div> }
    </div>
</div>
@section Scripts { <script src="~/js/pages/room.js" type="module" asp-append-version="true"></script> }
