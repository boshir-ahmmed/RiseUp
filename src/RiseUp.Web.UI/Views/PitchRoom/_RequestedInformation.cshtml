@model PitchRoomDto
<section class="card" id="information" aria-labelledby="information-heading">
    <div class="card-h">
        <h3 id="information-heading">Requested information</h3>
        @if (Model.InfoItems.Count > 0)
        {
            <span class="small muted">@Model.InfoItems.Count(i => i.AnsweredAtUtc.HasValue) of @Model.InfoItems.Count answered</span>
        }
    </div>
    <div class="card-b stack">
        @foreach (var item in Model.InfoItems)
        {
            var answered = item.AnsweredAtUtc.HasValue;
            <article class="qa" id="info-@item.Id" aria-labelledby="prompt-@item.Id" style="overflow-wrap:anywhere">
                <div class="row between">
                    <strong id="prompt-@item.Id">@item.Prompt</strong>
                    <span class="badge @(answered ? "b-ver" : "b-gray")">@(answered ? "Answered" : "Unanswered")</span>
                </div>
                @if (answered)
                {
                    <div class="qa-a small">
                        <strong>@Model.StartupName</strong> · @Ui.Dhaka(item.AnsweredAtUtc!.Value)
                        @if (item.ReplyText is not null) { <p style="white-space:pre-wrap">@item.ReplyText</p> }
                        @if (item.FileUrl is not null) { <a href="@item.FileUrl">Download @item.FileName</a> }
                    </div>
                }
                else if (Model.CanAnswer && !Model.StartupSuspended)
                {
                    <form method="post" enctype="multipart/form-data" action="/pitch-room/@Model.RequestId/information/@item.Id/reply" class="stack mt8" asp-antiforgery="true">
                        <label for="reply-@item.Id">Your reply</label>
                        <textarea class="input" id="reply-@item.Id" name="text" rows="2" maxlength="@BusinessRules.MoreInfoReplyMax" placeholder="Write a reply, attach a file, or both"></textarea>
                        <label class="small" for="attachment-@item.Id">Attachment · PDF, PPTX or XLSX · up to 10 MB</label>
                        <input id="attachment-@item.Id" name="file" type="file" accept=".pdf,.pptx,.xlsx" />
                        <div><button class="btn btn-primary btn-sm">Send reply</button></div>
                    </form>
                }
            </article>
        }
        @if (Model.CanDecide)
        {
            <form method="post" action="/pitch-room/@Model.RequestId/more-info" class="stack" asp-antiforgery="true">
                <label for="request-items">What do you need from the founder?</label>
                <textarea class="input" id="request-items" name="message" rows="3" placeholder="Quarterly revenue breakdown&#10;Latest financial model" required aria-describedby="request-help"></textarea>
                <p id="request-help" class="tiny muted mb0">Enter one item per line, up to @BusinessRules.MoreInfoBatchMax at a time and @BusinessRules.MoreInfoMax characters per item. The original decision deadline still applies.</p>
                <div><button class="btn btn-dark btn-sm">Send request</button></div>
            </form>
        }
    </div>
</section>
