@model PersonalProfileViewModel
@{
    ViewData["Title"] = "My profile";
    var profile = Model.Profile;
    Layout = "_AppLayout";
}
<div class="card prof">
    <div class="prof-cover" style="@Ui.CoverStyle(profile.CoverUrl)"></div>
    <div class="prof-b">
        <div class="prof-av"><partial name="_Avatar" model="(profile.Name, profile.PhotoUrl, profile.ColorIndex, 132)" /><partial name="_PersonalLogo" model="(profile.Name, profile.LogoUrl, profile.ColorIndex)" /></div>
        <div class="row between" style="align-items:flex-start">
            <div>
                <h1 class="prof-n">@profile.Name @if (profile.IsVerified) {<span class="vtick" style="font-size:14px;width:22px;height:22px" title="Verified account">✓</span>}</h1>
                <div class="prof-hl">@profile.Headline</div>
                <div class="small muted mt8">@if (profile.Location.Length > 0) {<span>📍 @profile.Location · </span>}@profile.RoleLine@if (profile.Link is not null) {<span> · <a href="@profile.Link" target="_blank" rel="noopener noreferrer nofollow">🔗 @profile.Link.Replace("https://", "").Replace("http://", "")</a></span>}</div>
                @if (profile.PendingName is not null) { <div class="notice n-info small mt16" style="display:block">Name change to <strong>@profile.PendingName</strong> is waiting for a Verification Administrator. Your current name stays visible until it's approved.</div> }
            </div>
            <div class="row">
                <a class="btn btn-primary" href="/me/edit"><partial name="_Icon" model='"edit"' /> Edit profile</a>
                @if (profile.InvestorId is int iid) { <a class="btn btn-outline" href="/investors/@iid">Public investor page</a> }
                else if (profile.StartupId is int sid) { <a class="btn btn-outline" href="/startups/@sid">Startup page</a> }
            </div>
        </div>
    </div>
</div>
<div class="grid mt16 g-detail" style="align-items:start">
    <div class="stack">
        @if (Model.Publications is not null) { <partial name="_ProfilePublications" model="Model.Publications" /> }
        <div class="card card-b"><h3>About</h3>
            @if (profile.Bio.Length > 0) { <p class="mb0" style="white-space:pre-wrap">@profile.Bio</p> }
            else { <p class="muted small mb0">@(profile.IsTeamMember ? "Team-member profiles show name, title and photo only." : "Add a short bio so founders and investors know who you are.")</p> }
        </div>
        @if (profile.StartupName is not null && profile.StartupId is int s2)
        {
            <div class="card card-b"><h3>Startup</h3><div class="row between"><strong>@profile.StartupName</strong><a class="btn btn-outline btn-sm" href="@(profile.IsTeamMember ? $"/startups/{s2}" : "/settings")">@(profile.IsTeamMember ? "View startup" : "Edit startup")</a></div></div>
        }
    </div>
    <div class="stack">
        <div class="card card-b package-progress"><h3>Profile completeness</h3>
            <div class="row between"><strong>@profile.Strength%</strong><span class="tiny muted">@(profile.Strength == 100 ? "Profile complete" : "Details filled in")</span></div>
            <progress value="@profile.Strength" max="100" aria-label="Profile completeness"></progress>
            <ul class="checklist">@foreach (var c in profile.Checklist) {<li class="@(c.Done ? "ok" : "")">@(c.Done ? "✓" : "○") @c.Item</li>}</ul>
            @if (profile.Strength < 100) { <a href="/me/edit">Complete profile details</a> }
        </div>
        <div class="card card-b small muted">Who sees this: @(profile.IsAdmin ? "administrators only." : "signed-in founders and investors see your name, photo and headline next to your comments and messages. Contact details stay private until a connection.")</div>
    </div>
</div>
