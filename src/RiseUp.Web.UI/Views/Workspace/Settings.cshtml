@model SettingsViewModel
@{ ViewData["Title"] = "Profile & settings"; var s = Model.Startup; }
<partial name="_PageHeader" model='("Profile & settings", (string?)null)' />
<div class="grid g2" style="align-items:start">
    @if (s is not null)
    {
        <div class="stack">
        <div class="card card-b" data-crop-host><h3>Branding</h3><p class="tiny muted">Logo and cover appear on your posts, pitch spotlight, pitch rooms and search results.</p>
            <div class="grid g2">
                <div class="field"><span>Logo</span><div class="row"><partial name="_Brand" model='(s.Name, s.ColorIndex, string.Empty, s.LogoUrl)' /><label class="btn btn-outline btn-sm upl">Upload logo<input type="file" accept="image/jpeg,image/png,image/webp" data-crop="logo" data-action="/settings/startup/logo" /></label>@if (s.LogoUrl is not null) {<form method="post" action="/settings/startup/logo/remove" class="inline" asp-antiforgery="true"><button class="btn btn-ghost btn-sm">Remove</button></form>}</div><div class="help"><span>Square · up to 2 MB</span></div></div>
                <div class="field"><span>Cover image</span><div class="cover-prev" style="height:64px;@(s.CoverUrl is null ? $"background:linear-gradient(120deg,{Ui.Color(s.ColorIndex)},#0F766E 60%,#134E4A)" : $"background:url('{s.CoverUrl}') center/cover")"></div><div class="row mt8"><label class="btn btn-outline btn-sm upl">Upload cover<input type="file" accept="image/jpeg,image/png,image/webp" data-crop="cover" data-action="/settings/startup/cover" /></label>@if (s.CoverUrl is not null) {<form method="post" action="/settings/startup/cover/remove" class="inline" asp-antiforgery="true"><button class="btn btn-ghost btn-sm">Remove</button></form>}</div></div>
            </div><div class="err" data-crop-error role="alert"></div></div>
        <form class="card card-b stack" method="post" action="/settings/startup" asp-antiforgery="true">
            <h3>Startup profile</h3><p class="tiny muted">Ordinary edits keep verification. Changing the registered name triggers re-verification.</p>
            <label class="field"><span>Registered name</span><input class="input" name="Name" value="@s.Name" maxlength="100" required /></label>
            <label class="field"><span>Tagline</span><input class="input" name="Tagline" value="@s.Tagline" maxlength="120" data-count="120" required /></label>
            <label class="field"><span>Description</span><textarea class="input" name="Description" maxlength="2000" data-count="2000" rows="5" required>@s.Description</textarea></label>
            <div class="grid g2"><label class="field"><span>Industry</span><input class="input" name="Industry" value="@s.Industry" required /></label><label class="field"><span>Stage</span><select class="input" name="Stage">@foreach (var st in Enum.GetValues<FundingStage>()) {<option value="@st" selected="@(s.Stage == st)">@Ui.Stage(st)</option>}</select></label></div>
            <div class="grid g2"><label class="field"><span>Location</span><input class="input" name="Location" value="@s.Location" required /></label><label class="field"><span>Founding year</span><input class="input" type="number" name="FoundingYear" value="@s.FoundingYear" /></label></div>
            <div class="grid g2"><label class="field"><span>Website</span><input class="input" name="Website" value="@s.Website" /></label><label class="field"><span>Funding goal (USD) · investors only</span><input class="input" type="number" min="0" name="FundingGoalUsd" value="@(s.FundingGoalUsd ?? 0)" /></label></div>
            <input type="hidden" name="BusinessModel" value="@s.BusinessModel" /><input type="hidden" name="Tags" value="@string.Join(",", s.Tags)" />
            <button class="btn btn-primary">Save profile</button>
        </form>
        </div>
    }
    <div class="stack">
        <form class="card card-b stack" id="verification" method="post" action="/verification" enctype="multipart/form-data" asp-antiforgery="true">
            <h3>Verification</h3>
            <p class="small muted">Reviewed manually by a Verification Administrator. AI is never used for this decision. No reminder email is sent before expiry.</p>
            @if (s is not null)
            {
                <div class="grid g2"><label class="field"><span>Trade licence names</span><select class="input" name="licenceHolderType"><option value="@LicenceHolderType.Individual">An individual (must be you)</option><option value="@LicenceHolderType.Company">A company (attach registration)</option></select></label><label class="field"><span>Licence holder name</span><input class="input" name="licenceHolderName" required /></label></div>
            }
            <label class="field"><span>NID / passport, trade licence, ownership or credential evidence</span><input class="input" type="file" name="files" multiple accept=".pdf,.jpg,.jpeg,.png" required /></label>
            <button class="btn btn-outline">Submit for manual review</button>
        </form>
        @if (Model.Investor is not null)
        {
            <form class="card card-b" method="post" action="/settings/receive-pitches" asp-antiforgery="true"><h3>Receive Pitches</h3><p class="small muted">Turning this off blocks new pitches (founders aren't charged). Pending pitches and chats are unaffected.</p><input type="hidden" name="receive" value="@((!Model.Investor.Card.ReceivePitches).ToString().ToLowerInvariant())" /><button class="btn btn-outline">Currently @(Model.Investor.Card.ReceivePitches ? "ON — turn off" : "OFF — turn on")</button></form>
        }
        @if (s is not null)
        {
            <form class="card card-b stack" method="post" action="/settings/ownership-transfer" asp-antiforgery="true"><h3>Ownership transfer</h3><p class="small muted">Needs your consent, the incoming owner's consent and manual approval. A claimant cannot take over on documents alone.</p>
                <label class="field"><span>Incoming owner's legal name</span><input class="input" name="incomingName" required /></label><label class="field"><span>Incoming owner's email</span><input class="input" type="email" name="incomingEmail" required /></label><button class="btn btn-outline">Record my consent</button></form>
        }
        <form class="card card-b stack" method="post" action="/account/delete" style="border-color:#F4C7C3" asp-antiforgery="true"><h3 style="color:var(--danger)">Delete account</h3>
            <p class="small muted">Permanent. @(s is not null ? "Your public startup and posts are removed, team accounts deactivated, pending requests cancelled, and unused welcome and purchased credits forfeited." : "Pending requests are cancelled and your identity is anonymised in remaining conversations.") Identity documents are erased unless a legal hold applies.</p>
            <label class="field"><span>Type DELETE to confirm</span><input class="input" name="confirmation" required /></label><button class="btn btn-danger">Delete my account</button></form>
    </div>
</div>

@section Scripts { <script src="~/js/pages/cropper.js" type="module" asp-append-version="true"></script> }
