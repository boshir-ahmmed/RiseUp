@model TeamPageViewModel
@{
    ViewData["Title"] = "Team accounts";
    var full = Model.Members.Count >= BusinessRules.MaxTeamAccounts;
    var editing = Model.EditingId.HasValue;
    var form = Model.Form;
}
<partial name="_PageHeader" model='("Team accounts", (string?)"Manage your team’s logins and access to investor conversations.")' />
@if (TempData["oneTime"] is string cred)
{
    var parts = cred.Split('|');
    <div class="notice n-warn" style="margin-bottom:16px"><div><strong>Shown once.</strong> Username <code>@parts[0]</code> · temporary password <code style="font-size:15px">@parts[1]</code><br /><span class="small">Copy it now and share it securely. It is stored only as a one-way hash and will never be displayed or emailed again.</span></div></div>
}
<div class="grid g-detail team-manager">
    <section class="card">
        <div class="card-h"><h2>Members</h2><span class="small muted">@Model.Members.Count / @BusinessRules.MaxTeamAccounts slots used</span></div>
        @if (Model.Members.Count == 0) { <p class="empty">Add your first team member.</p> }
        @foreach (var t in Model.Members)
        {
            <article class="card-b team-member">
                <div class="row between"><strong>@t.FullName</strong><span class="badge @Ui.StatusClass(t.Status.ToString())">@t.Status</span></div>
                <p class="small muted">@t.Designation · @t.Username · @t.Email</p>
                <p class="small">@(t.GroupMode switch { TeamGroupMode.All => "All groups", TeamGroupMode.AllExcept => $"All groups except {t.GroupIds.Count}", _ => $"Selected groups ({t.GroupIds.Count})" })</p>
                <div class="row">
                    <a class="btn btn-outline btn-sm" href="/team?edit=@t.Id#member-form">Edit member</a>
                    @if (t.Status == TeamAccountStatus.Active)
                    {
                        <form method="post" action="/team/@t.Id/reset" asp-antiforgery="true"><button class="btn btn-ghost btn-sm" data-confirm="Generate a replacement password?">Generate new password</button></form>
                        <form method="post" action="/team/@t.Id/deactivate" asp-antiforgery="true"><button class="btn btn-ghost btn-sm">Deactivate</button></form>
                    }
                    else
                    {
                        <form method="post" action="/team/@t.Id/reactivate" class="row" asp-antiforgery="true">
                            <label class="check small"><input type="checkbox" name="restore" value="true" checked /> Restore assigned groups</label>
                            <button class="btn btn-outline btn-sm">Reactivate</button>
                        </form>
                    }
                    <form method="post" action="/team/@t.Id/delete" asp-antiforgery="true"><button class="btn btn-danger btn-sm" data-confirm="Permanently delete this team account?">Delete</button></form>
                </div>
            </article>
        }
    </section>
    <form id="member-form" class="card card-b stack" method="post" action="@(editing ? $"/team/{Model.EditingId}/edit" : "/team")" asp-antiforgery="true">
        <h2>@(editing ? "Edit team member" : "Add team member")</h2>
        @if (full && !editing) { <p class="notice n-warn small">All five slots are occupied. You can still edit existing members.</p> }
        <label class="field"><span>Full name</span><input class="input" name="FullName" value="@form.FullName" required maxlength="150" /></label>
        <label class="field"><span>Designation</span><input class="input" name="Designation" value="@form.Designation" required maxlength="100" /></label>
        <label class="field"><span>Username</span><input class="input" name="Username" value="@form.Username" required pattern="[a-z0-9._]{3,30}" maxlength="30" /><small class="muted">3–30 lowercase letters, digits, dots or underscores.</small></label>
        <label class="field"><span>Email</span><input class="input" type="email" name="Email" value="@form.Email" maxlength="256" required /></label>
        <label class="field"><span>LinkedIn (optional)</span><input class="input" name="LinkedInUrl" value="@form.LinkedInUrl" maxlength="200" /></label>
        <label class="field"><span>@(editing ? "New password" : "Password")</span><input class="input" name="Password" type="password" autocomplete="new-password" minlength="@PasswordPolicy.MinimumLength" maxlength="100" pattern="@PasswordPolicy.BrowserPattern" title="@PasswordPolicy.Requirements" />
            <small class="muted">@PasswordPolicy.Requirements @(editing ? "Leave blank to keep the current password." : "Leave blank to generate a password shown once after creation.")</small>
            @if (ViewData["ReenterPassword"] is true) { <small>Enter your chosen password again before saving.</small> }
        </label>
        <fieldset class="team-groups stack">
            <legend>Group access</legend>
            <label class="check"><input type="radio" name="GroupMode" value="Selected" checked="@(form.GroupMode == TeamGroupMode.Selected)" /> Selected groups only</label>
            <label class="check"><input type="radio" name="GroupMode" value="All" checked="@(form.GroupMode == TeamGroupMode.All)" /> All groups</label>
            <label class="check"><input type="radio" name="GroupMode" value="AllExcept" checked="@(form.GroupMode == TeamGroupMode.AllExcept)" /> All groups except selected</label>
            <div class="team-group-picker">
                <strong class="small team-include">Groups to include</strong><strong class="small team-exclude">Groups to exclude</strong>
                @if (Model.Groups.Count == 0) { <p class="small muted">Groups appear when a pitch or invitation is accepted.</p> }
                @foreach (var group in Model.Groups.OrderBy(g => g.Title))
                {
                    <label class="check"><input type="checkbox" name="GroupIds" value="@group.Id" checked="@(form.GroupIds?.Contains(group.Id) == true)" /> @group.Title</label>
                }
            </div>
            <p class="small muted mb0">Both “All” options include future groups. Members can read the full history of assigned conversations.</p>
        </fieldset>
        <div class="row"><button class="btn btn-primary" disabled="@(full && !editing)">@(editing ? "Save changes" : "Create account")</button>
            @if (editing) { <a class="btn btn-ghost" href="/team">Cancel</a> }</div>
    </form>
</div>
