@using RiseUp.Entities.Abstractions
@model WalletViewModel
@{
    ViewData["Title"] = "Wallet";
    var returnedOrder = Model.Orders.FirstOrDefault(o => o.OrderNumber == Context.Request.Query["order"].ToString());
    string OrderMessage(OrderDto o) => o.Status switch
    {
        PaymentStatus.Paid when o.Credited => "Payment confirmed. Credits added to your wallet.",
        PaymentStatus.Pending => "Waiting for payment confirmation. Check this order again before making another purchase.",
        PaymentStatus.RequiresReview => "Your payment is under review. Keep your order number for reference.",
        PaymentStatus.Refunded => "This payment was refunded.",
        PaymentStatus.Failed => "Payment failed. You can start a new order.",
        _ => "Payment recorded. Check the credit history below for your balance."
    };
}
<partial name="_PageHeader" model='("Wallet", (string?)"Pitches use welcome credits first. Promotions use purchased credits only.")' />
<div class="grid g3">
    <div class="card kpi"><div class="l">Welcome credits</div><div class="v">@Model.Wallet.WelcomeBalance</div><div class="tiny muted">One-time grant · pitches only · never expire</div></div>
    <div class="card kpi"><div class="l">Purchased credits</div><div class="v">@Model.Wallet.PurchasedBalance</div><div class="tiny muted">Pitches &amp; promotions · never expire</div></div>
    <div class="card kpi"><div class="l">Payment provider</div><strong>@(Model.Mode switch { PaymentMode.Live => "SSLCOMMERZ", PaymentMode.HostedTest => "SSLCOMMERZ test store", PaymentMode.Simulator => "Development simulator", _ => "Purchases closed" })</strong></div>
</div>
@if (Model.Mode != PaymentMode.Disabled && Model.Packages.Count > 0)
{
    <form class="card card-b stack mt24" method="post" action="/wallet/buy" asp-antiforgery="true">
        <h3>Buy RiseUp Credits</h3>
        <fieldset class="package-picker"><legend>Choose a credit package</legend>
            <div class="package-options">@foreach (var p in Model.Packages)
            {
                <label><input type="radio" name="packageId" value="@p.Id" checked="@(p.Id == Model.Packages[0].Id)" required /><span><strong>@p.Tokens credits</strong><span>@Ui.Bdt(p.PriceBdt)</span></span></label>
            }</div>
        </fieldset>
        @if (Model.Mode is PaymentMode.HostedTest or PaymentMode.Live)
        {
            <p>Choose bKash, Nagad or another available method on the SSLCOMMERZ checkout page.</p>
            <label class="field"><span>Billing address</span><input class="input" name="billing.Address" autocomplete="street-address" maxlength="50" required /></label>
            <label class="field"><span>Billing phone (if different or missing from your account)</span><input class="input" type="tel" name="billing.Phone" autocomplete="tel" maxlength="20" /></label>
            <div class="grid g3">
                <label class="field"><span>City</span><input class="input" name="billing.City" autocomplete="address-level2" maxlength="50" required /></label>
                <label class="field"><span>Postal code</span><input class="input" name="billing.Postcode" autocomplete="postal-code" maxlength="30" required /></label>
                <label class="field"><span>Country</span><input class="input" name="billing.Country" autocomplete="country-name" maxlength="50" value="Bangladesh" required /></label>
            </div>
        }
        <button class="btn btn-primary" type="submit">Continue to checkout</button>
    </form>
}
<div class="card mt24" id="orders"><div class="card-h"><h3>Payment orders</h3><span class="tiny muted">Credits are added after payment is confirmed</span></div>
    @if (returnedOrder is not null)
    {
        <section class="card-b" role="status"><strong>Order @returnedOrder.OrderNumber</strong><p>@OrderMessage(returnedOrder)</p>
            @if (returnedOrder.Method?.StartsWith("Demo · ", StringComparison.Ordinal) == true) { <p class="small">@returnedOrder.Method</p> }
            @if (Model.Mode == PaymentMode.Simulator && returnedOrder.Status == PaymentStatus.Pending && returnedOrder.OrderNumber.StartsWith("PO-", StringComparison.Ordinal))
            {
                <a class="btn btn-primary btn-sm" href="@Url.Action("SandboxCheckout", "Payments", new { orderNumber = returnedOrder.OrderNumber })">Resume demo checkout</a>
            }
            @if (returnedOrder.Status is PaymentStatus.Pending or PaymentStatus.RequiresReview) { <a class="btn btn-outline btn-sm" href="@Url.Action("Wallet", "Workspace", new { order = returnedOrder.OrderNumber })#orders">Refresh order status</a> }
        </section>
    }
    @if (Model.Orders.Count == 0) { <div class="empty">No orders</div> }
    else { <div class="tbl-wrap"><table class="tbl"><thead><tr><th>Order</th><th>Package</th><th>Status</th><th>Provider ref</th></tr></thead><tbody>@foreach (var o in Model.Orders) {<tr><td><a href="@Url.Action("Wallet", "Workspace", new { order = o.OrderNumber })#orders">@o.OrderNumber</a><div class="tiny muted">@Ui.Dhaka(o.CreatedAtUtc)</div></td><td>@o.Tokens credits · @Ui.Bdt(o.PriceBdt)</td><td><span class="badge @Ui.StatusClass(o.Status.ToString())">@o.Status</span></td><td class="small">@(o.ProviderTransactionId ?? "—")</td></tr>}</tbody></table></div> }
</div>
<div class="card mt24"><div class="card-h"><h3>Credit history</h3></div><div class="tbl-wrap"><table class="tbl"><thead><tr><th>When</th><th>Entry</th><th>Bucket</th><th style="text-align:right">Amount</th></tr></thead><tbody>
    @foreach (var l in Model.Wallet.Ledger) {<tr><td class="small">@Ui.Dhaka(l.AtUtc)</td><td class="small">@l.Description<div class="tiny muted"><code>@l.Reference</code></div></td><td><span class="badge b-gray">@l.Bucket</span></td><td style="text-align:right;font-weight:650;color:@(l.Amount < 0 ? "var(--danger)" : "var(--teal-d)")">@(l.Amount > 0 ? "+" : "")@l.Amount</td></tr>}
</tbody></table></div></div>
