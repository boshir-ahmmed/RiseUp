@model string
@{
    var title = Model switch { "terms" => "Terms of Use", "privacy" => "Privacy Policy", "retention" => "Data Retention Policy", "guidelines" => "Community Guidelines", _ => "Legal" };
    ViewData["Title"] = title;
}
<section class="section" style="padding-top:40px"><div class="container" style="max-width:820px"><h1 style="font-size:34px">@title</h1>
    <div class="notice n-warn">Draft template for review by qualified Bangladeshi counsel. It does not assert compliance with any specific law.</div>
    <div class="card card-b mt16 small"><p>Version 0.1 · Effective date: to be confirmed.</p><p>RiseUp provides discovery and communication services between founders and investors. RiseUp does not provide investment advice, brokerage, underwriting, custody or escrow services, and does not process investment transactions.</p></div>
</div>
    @if (Model is "privacy" or "retention")
    {
        <div class="card card-b mt16 small"><h2>Identity verification documents</h2>
            <p>RiseUp asks founders for an NID or passport and a trade licence. A company licence also needs registration evidence showing the founder’s authority. Investors submit identity evidence and a professional or company credential.</p>
            <p>RiseUp stores the files privately and scans them before review. Verification Administrators and Super Admins can open evidence for pending applications after signing in with a second factor. RiseUp records which reviewer opened each document.</p>
            <p>Permanent account deletion closes review access. A scheduled job erases the account’s evidence from primary storage. A documented legal or investigation hold preserves the affected files until a Super Admin releases it.</p>
        </div>
    }
</section>
