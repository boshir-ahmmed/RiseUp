@{ ViewData["Title"] = "About"; }
<section class="hero"><div class="container hero-grid">
    <div><span class="eyebrow">● Built for Bangladesh's startup ecosystem</span>
        <h1>A place for Bangladesh’s founders and investors to meet.</h1>
        <p class="lead">Explore public profiles, check verification badges and learn what each member is looking for. When a pitch or invitation is accepted, both sides can talk in a private conversation.</p>
        <div class="row mt24"><a class="btn btn-primary btn-lg" href="/register">Join as Founder or Investor</a><a class="btn btn-outline btn-lg" href="/startups">Browse startups</a></div>
        <div class="row mt24 small muted" style="gap:18px"><span>✓ Manual verification</span><span>✓ Contact details only after connection</span><span>✓ No investment advice or escrow</span></div>
    </div>
    <div class="hero-panel"><strong style="color:#fff">What a badge means</strong><p class="small mt8" style="color:#94A3B8">Verification confirms identity and business or credential documents were reviewed by a person. It is not an assessment of performance, solvency or investment risk.</p></div>
</div></section>
<section class="section alt"><div class="container"><div class="grid g3">
    <div class="card mk-card card-b"><h3>Human verification</h3><p class="small muted mb0">Identity, trade licence and ownership evidence are checked by a Verification Administrator. AI never approves documents.</p></div>
    <div class="card mk-card card-b"><h3>Privacy until connection</h3><p class="small muted mb0">Emails, phone numbers and direct links stay hidden until a pitch or invitation is accepted.</p></div>
    <div class="card mk-card card-b"><h3>Not investment advice</h3><p class="small muted mb0">Investment agreements and transfers happen outside RiseUp. Do your own due diligence.</p></div>
</div></div></section>
