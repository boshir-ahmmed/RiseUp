@model RiseUp.Web.UI.Components.ShellModel
@{ var s = Model.Shell; }
<header class="tb" role="banner"><div class="tb-in">
    <a class="brand" href="/" aria-label="RiseUp home feed"><span class="brand-mark"><svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 12l4-4 2.5 2.5L13 5" stroke="#36D3C4" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M9.5 5H13v3.5" stroke="#36D3C4" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></span><span class="hide-s">RiseUp</span></a>
    <form class="tb-search profile-lookup" data-profiles="all" method="get" action="/search" role="search"><partial name="_Icon" model='"search"' /><label class="sr" for="tbq">Search startups and investors</label><input id="tbq" name="q" maxlength="100" placeholder="Search startups and investors…" autocomplete="off" /></form>
    <nav class="tb-nav" aria-label="Primary">
        @foreach (var i in Model.Top)
        {
            var on = Model.IsOn(i.Href);
            <a href="@i.Href" title="@i.Label" class="@(on ? "on" : "")" aria-label="@(i.Badge > 0 ? $"{i.Label}, {i.Badge} new" : i.Label)" aria-current="@(on ? "page" : null)"><partial name="_Icon" model="i.Icon" /><span class="lbl">@i.Label</span>@if (i.Badge > 0) {<span class="dot">@(i.Badge > 9 ? "9+" : i.Badge.ToString())</span>}</a>
        }
    </nav>
    <div class="tb-me">
        <button type="button" class="tb-mebtn" data-toggle="#memenu" aria-label="Account menu" aria-expanded="false" aria-controls="memenu"><partial name="_Avatar" model="(s.Name, s.PhotoUrl, s.ColorIndex, 26)" /><span class="lbl">Me <partial name="_Icon" model='"chevron-down"' /></span></button>
        <div class="menu" id="memenu">
            <div class="menu-h"><partial name="_Avatar" model="(s.Name, s.PhotoUrl, s.ColorIndex, 48)" /><div class="account-identity"><strong>@s.Name</strong><div class="tiny muted ell">@s.Headline</div></div></div>
            <a class="btn btn-outline btn-sm account-profile" href="/me">View profile</a>
            <a class="account-item" href="/me/edit"><partial name="_Icon" model='"edit"' /> Edit profile &amp; photo</a>
            @if (Model.Actor.IsFounder || Model.Actor.IsInvestor) { <a class="account-item" href="/dashboard"><partial name="_Icon" model='"dashboard"' /> Dashboard</a> }
            @if (Model.Actor.IsFounder) { <a class="account-item" href="/settings"><partial name="_Icon" model='"building"' /> Startup profile</a><a class="account-item" href="/wallet"><partial name="_Icon" model='"wallet"' /> Wallet</a> }
            @if (Model.Actor.IsInvestor) { <a class="account-item" href="/shortlist"><partial name="_Icon" model='"star"' /> Shortlist</a><a class="account-item" href="/settings"><partial name="_Icon" model='"preferences"' /> Preferences</a> }
            @if (Model.Actor.IsAnyAdmin) { <a class="account-item" href="/admin"><partial name="_Icon" model='"shield"' /> Admin console</a> }
            <fieldset class="sound-settings" data-sound-account="@Model.Actor.ViewerKey" hidden>
                <legend>Sounds on this device</legend>
                <label><input type="checkbox" data-tone="alert" checked /> Notifications</label>
                <label><input type="checkbox" data-tone="message" checked /> Messages</label>
            </fieldset>
            <form method="post" action="/logout" asp-antiforgery="true"><button class="account-item" type="submit"><partial name="_Icon" model='"logout"' /> Sign out</button></form>
        </div>
    </div>
</div></header>
