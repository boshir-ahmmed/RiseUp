@model SpotlightDto
@{
    var signedIn = User.Identity?.IsAuthenticated == true;
}
<article class="card pk" aria-label="Pitch spotlight: @Model.Name">
    <div class="pk-media" style="--pc:@Ui.Color(Model.ColorIndex)">
        <video src="@Model.Teaser.Url" poster="@Model.Teaser.PosterUrl" muted controls playsinline preload="none" data-feedvideo aria-label="@Model.Name teaser"></video>
        <span class="pk-tag">Pitch spotlight</span>
    </div>
    <div class="pk-b">
        <div class="row" style="gap:12px;flex-wrap:nowrap"><partial name="_Brand" model="(Model.Name, Model.ColorIndex, string.Empty, Model.LogoUrl)" />
            <div style="min-width:0;flex:1"><div class="pk-n"><a href="/startups/@Model.StartupId" style="color:inherit">@Model.Name</a> <span class="vtick">✓</span></div><div class="small muted">@Model.Tagline</div></div></div>
        <div class="row" style="gap:6px"><span class="chip">@Model.Industry</span><span class="chip">@Ui.Stage(Model.Stage)</span><span class="chip">@Model.Location</span>
            @if (Model.Demo is not null) { <a class="chip chip-btn" href="@Model.Demo.Url" target="_blank" rel="noopener">▶ Product demo</a> }</div>
        @if (Model.Ask is not null)
        {
            <div class="pk-ask"><div><div class="tiny muted">Raising</div><div class="pk-amt">@Ui.Usd(Model.Ask.AmountUsd)</div></div><div><div class="tiny muted">Instrument</div><strong class="small">@Model.Ask.InstrumentLabel</strong></div>
                <div><div class="tiny muted">Min ticket</div><strong class="small">@Ui.Usd(Model.Ask.MinTicketUsd)</strong></div><div><div class="tiny muted">Runway</div><strong class="small">@Model.Ask.RunwayMonths mo</strong></div></div>
            @if (Model.Metrics is { Count: > 0 }) { <div class="pk-m">@foreach (var m in Model.Metrics) {<div><b>@m.Value</b><span>@m.Name</span></div>}</div> }
        }
        else
        {
            <div class="pk-lock">🔒 The ask, metrics and full pitch room are visible to verified investors.</div>
        }
        @if (Model.Highlights.Count > 0) { <ul class="pk-hl">@foreach (var h in Model.Highlights) {<li>@h</li>}</ul> }
        <div class="row">
            @if (Model.ViewerIsVerifiedInvestor)
            {
                if (Model.PendingPitchRequestId is int rid) { <a class="btn btn-primary" href="/pitch-room/@rid">Open pitch room</a> }
                else if (Model.Connected) { <span class="badge b-ver">Connected</span> <a class="btn btn-primary" href="/conversations">Message</a> }
                else if (Model.InvitationPending) { <span class="badge b-pend">Invitation pending</span> }
                else { <form method="post" action="/startups/@Model.StartupId/invite" class="inline" asp-antiforgery="true"><input type="hidden" name="idempotencyKey" value="@Guid.NewGuid().ToString("N")" /><input type="hidden" name="note" value="I'd like to see your full pitch." /><button class="btn btn-primary">Invite to connect</button></form> }
                <form method="post" action="/shortlist/@Model.StartupId/toggle" class="inline" asp-antiforgery="true"><button class="btn btn-outline">@(Model.Shortlisted ? "★ Shortlisted" : "☆ Shortlist")</button></form>
            }
            else if (!signedIn) { <a class="btn btn-primary" href="/register">Join to see the full pitch</a> }
            <a class="btn btn-ghost" href="/startups/@Model.StartupId">View details</a>
        </div>
    </div>
</article>
