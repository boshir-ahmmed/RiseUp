@model SpotlightDto
@{
    var signedIn = User.Identity?.IsAuthenticated == true;
}
<article class="card pk" aria-label="Pitch spotlight: @Model.Name">
    <header class="pk-header">
        <div class="pk-kicker">
            <span class="pk-tag">Pitch spotlight</span>
            @if (Model.Teaser.Seconds > 0)
            {
                <span class="pk-dur">@(Model.Teaser.Seconds / 60):@((Model.Teaser.Seconds % 60).ToString("00")) teaser</span>
            }
        </div>
        <div class="row pk-identity">
            <partial name="_Brand" model="(Model.Name, Model.ColorIndex, string.Empty, Model.LogoUrl)" />
            <div>
                <h3 class="pk-n"><a href="/startups/@Model.StartupId">@Model.Name</a> <span class="vtick"><span aria-hidden="true">✓</span><span class="sr">Verified startup</span></span></h3>
                <p class="small muted">@Model.Tagline</p>
            </div>
        </div>
    </header>
    <div class="pk-media">
        <video src="@Model.Teaser.Url" poster="@Model.Teaser.PosterUrl" muted controls playsinline preload="none" data-feedvideo aria-label="@Model.Name teaser"></video>
    </div>
    <div class="pk-b">
        <div class="row pk-meta">
            <span class="chip">@Model.Industry</span><span class="chip">@Ui.Stage(Model.Stage)</span><span class="chip">@Model.Location</span>
            @if (Model.Demo is not null)
            {
                <a class="chip chip-btn" href="@Model.Demo.Url" target="_blank" rel="noopener">Watch product demo<span class="sr"> (opens in a new tab)</span></a>
            }
        </div>
        @if (Model.Highlights.Count > 0)
        {
            <section>
                <h4>Pitch highlights</h4>
                <ul class="pk-hl">@foreach (var h in Model.Highlights) { <li>@h</li> }</ul>
            </section>
        }
        @if (Model.Ask is not null)
        {
            <dl class="pk-ask">
                <div class="pk-raising"><dt>Raising</dt><dd class="pk-amt">@Ui.Usd(Model.Ask.AmountUsd)</dd></div>
                <div><dt>Instrument</dt><dd>@Model.Ask.InstrumentLabel</dd></div>
                <div><dt>Minimum ticket</dt><dd>@Ui.Usd(Model.Ask.MinTicketUsd)</dd></div>
                <div><dt>Runway</dt><dd>@Model.Ask.RunwayMonths mo</dd></div>
            </dl>
            @if (Model.Metrics is { Count: > 0 })
            {
                <dl class="pk-m">
                    @foreach (var m in Model.Metrics) { <div><dt>@m.Name</dt><dd>@m.Value</dd></div> }
                </dl>
            }
        }
        else
        {
            <p class="pk-lock"><partial name="_Icon" model='"shield"' /> Funding terms and metrics are available to verified investors.</p>
        }
    </div>
    <footer class="row pk-actions">
        @if (Model.ViewerIsVerifiedInvestor)
        {
            if (Model.PendingPitchRequestId is int rid) { <a class="btn btn-primary" href="/pitch-room/@rid">Open pitch room</a> }
            else if (Model.Connected) { <span class="badge b-ver">Connected</span> <a class="btn btn-primary" href="/conversations">Message</a> }
            else if (Model.InvitationPending) { <span class="badge b-pend">Invitation pending</span> }
            else
            {
                <form method="post" action="/startups/@Model.StartupId/invite" class="inline" asp-antiforgery="true">
                    <input type="hidden" name="idempotencyKey" value="@Guid.NewGuid().ToString("N")" />
                    <input type="hidden" name="note" value="I'd like to see your full pitch." />
                    <button class="btn btn-primary">Invite to connect</button>
                </form>
            }
            <form method="post" action="/shortlist/@Model.StartupId/toggle" class="inline" asp-antiforgery="true">
                <button class="btn btn-outline" aria-pressed="@(Model.Shortlisted ? "true" : "false")"><partial name="_Icon" model='"star"' /> Shortlist</button>
            </form>
        }
        else if (!signedIn) { <a class="btn btn-primary" href="/register">Join RiseUp</a> }
        <a class="btn btn-ghost" href="/startups/@Model.StartupId">Startup profile</a>
    </footer>
</article>
