@model FeedItemDto
@{
    var canInteract = ViewData["CanInteract"] is true;
    var signedIn = User.Identity?.IsAuthenticated == true;
    var hasMedia = Model.VideoUrl is not null || Model.PosterUrl is not null;
    var categoryClass = Model.Category switch
    {
        PostCategory.Announcements => "cat-announcements",
        PostCategory.Milestones => "cat-milestones",
        PostCategory.Products => "cat-products",
        PostCategory.Achievements => "cat-achievements",
        PostCategory.Funding => "cat-funding",
        _ => "cat-other"
    };
}
<article class="ig card pc" aria-labelledby="pt-@Model.Id">
    <header class="pc-h">
        <a href="/startups/@Model.StartupId" aria-label="@Model.StartupName profile"><partial name="_Brand" model="(Model.StartupName, Model.ColorIndex, string.Empty, Model.LogoUrl)" /></a>
        <div class="pc-author">
            <div class="row pc-byline"><a href="/startups/@Model.StartupId" class="ig-name">@Model.StartupName</a>@if (Model.StartupVerified) {<span class="vtick" title="Verified Startup — identity and ownership checked, not an investment endorsement">✓</span>}<span class="tiny muted">· @Ui.Stage(Model.StartupStage)</span></div>
            <div class="tiny muted ell">@Model.StartupTagline</div>
            <div class="tiny muted">@if (Model.IsPromoted) {<span class="promo-l">Promoted</span><text> · </text>}@Ui.Ago(Model.PublishedAtUtc) · @Model.StartupLocation</div>
        </div>
        <span class="catc @categoryClass">@Model.Category</span>
    </header>
    <div class="@(hasMedia ? "ig-media" : "pc-text pc-text-only") @(hasMedia && Model.Category == PostCategory.Reel ? "portrait-frame" : "")" data-dbl="@Model.Id">
        @if (Model.VideoUrl is not null)
        {
            <video src="@Model.VideoUrl" poster="@Model.PosterUrl" class="ig-img" controls muted playsinline preload="none" data-feedvideo aria-label="@Model.Title"></video>
            @if (Model.VideoSeconds is int secs) {<span class="vd" aria-hidden="true">@(secs / 60):@((secs % 60).ToString("00"))</span>}
        }
        else if (Model.PosterUrl is not null)
        {
            <img class="ig-img" src="@Model.PosterUrl" alt="@Model.Title" loading="lazy" />
        }
        else
        {
            <h3 class="pc-title" id="pt-@Model.Id"><a href="/posts/@Model.Id">@Model.Title</a></h3>
        }
        <div class="ig-burst" data-burst="@Model.Id" aria-hidden="true">♥</div>
    </div>
    <div class="pc-text">
        @if (hasMedia)
        {
            <h3 class="pc-title" id="pt-@Model.Id"><a href="/posts/@Model.Id">@Model.Title</a></h3>
        }
        <div class="small pc-body"><partial name="_ReadMore" model="(Model.Body, 190)" /></div>
    </div>
    <div class="pc-stats"><span><span class="hb" aria-hidden="true">♥</span> Likes <span data-likes="@Model.Id">@Model.Likes</span></span><span><a href="/posts/@Model.Id#comments">@Model.Comments comment@(Model.Comments == 1 ? "" : "s")</a> · @Model.Shares shares · @Model.Views.ToString("N0") views</span></div>
    <div class="pc-acts">
        <button type="button" class="@(Model.LikedByMe ? "on" : "")" data-like="@Model.Id" data-can="@(canInteract ? "1" : "0")" aria-pressed="@(Model.LikedByMe ? "true" : "false")" aria-label="Like"><svg width="20" height="20" viewBox="0 0 24 24" fill="@(Model.LikedByMe ? "#E11D48" : "none")" stroke="@(Model.LikedByMe ? "#E11D48" : "currentColor")" stroke-width="1.9" stroke-linejoin="round" aria-hidden="true"><path d="M12 20.5S3.5 15.4 3.5 9.3A4.6 4.6 0 0 1 12 6.6a4.6 4.6 0 0 1 8.5 2.7c0 6.1-8.5 11.2-8.5 11.2z"/></svg><span>Like</span></button>
        <a href="/posts/@Model.Id#comments" class="pc-act" aria-label="Comment"><partial name="_Icon" model='"cmt"' /><span>Comment</span></a>
        <button type="button" data-share="@Model.Id" data-can="@(canInteract ? "1" : "0")" aria-label="Share link"><partial name="_Icon" model='"share"' /><span>Share</span></button>
        @if (signedIn) { <button type="button" class="@(Model.SavedByMe ? "on" : "")" data-save="@Model.Id" aria-pressed="@(Model.SavedByMe ? "true" : "false")" aria-label="Save"><partial name="_Icon" model='"save"' /><span>@(Model.SavedByMe ? "Saved" : "Save")</span></button> }
        else { <a href="/login" class="pc-act" aria-label="Sign in to save"><partial name="_Icon" model='"save"' /><span>Save</span></a> }
    </div>
    @if (Model.LatestComments is { Count: > 0 } latest)
    {
        <div class="pc-cmts">
            @if (Model.Comments > latest.Count) { <a href="/posts/@Model.Id#comments" class="small muted">View all @Model.Comments comments</a> }
            @foreach (var c in latest)
            {
                <div class="pc-c"><partial name="_Avatar" model="(c.AuthorName, c.AuthorPhotoUrl, c.AuthorName.Length, 32)" /><div class="pc-cb"><strong class="small">@c.AuthorName</strong><div class="small"><partial name="_ReadMore" model="(c.Body, 110)" /></div></div></div>
            }
        </div>
    }
    @if (canInteract)
    {
        <form class="ig-cform" method="post" action="/posts/@Model.Id/comments" asp-antiforgery="true">
            <label class="sr" for="c-@Model.Id">Add a comment</label>
            <input id="c-@Model.Id" name="body" maxlength="1000" placeholder="Add a comment…" autocomplete="off" required />
            <button>Post</button>
        </form>
    }
    else
    {
        <div class="ig-cform tiny muted">@if (!signedIn) {<span><a href="/login">Sign in</a> as a verified founder or investor to like or comment.</span>} else {<span>Only verified founders and investors can like or comment.</span>}</div>
    }
</article>
