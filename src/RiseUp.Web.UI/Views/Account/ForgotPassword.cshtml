@{ ViewData["Title"] = "Reset password"; }
<section class="section" style="padding-top:48px"><div class="container" style="max-width:460px">
    <form class="card mk-card card-b stack" method="post" action="/account/forgot-password" asp-antiforgery="true"><h1 style="font-size:24px">Reset password</h1><p class="small muted">We'll email a single-use link that expires in 60 minutes.</p>
        <label class="field"><span>Email</span><input class="input" type="email" name="email" required /></label><button class="btn btn-primary">Send reset link</button></form>
</div></section>
