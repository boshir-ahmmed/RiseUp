@model string
@{ ViewData["Title"] = "Choose a new password"; }
<section class="section" style="padding-top:48px"><div class="container" style="max-width:460px">
    <form class="card mk-card card-b stack" method="post" action="/account/reset-password" asp-antiforgery="true"><h1 style="font-size:24px">Choose a new password</h1>
        <input type="hidden" name="token" value="@Model" />
        <label class="field"><span>New password</span><input class="input" type="password" name="password" minlength="@PasswordPolicy.MinimumLength" pattern="@PasswordPolicy.BrowserPattern" title="@PasswordPolicy.Requirements" required autocomplete="new-password" aria-describedby="Password-help" /><span class="help" id="Password-help">@PasswordPolicy.Requirements</span></label><button class="btn btn-primary">Update password</button></form>
</div></section>
