@{ ViewData["Title"] = "Join RiseUp"; }
<section class="section onboarding"><div class="container role-selection">
    <header><h1>How will you use RiseUp?</h1><p class="muted">Choose the role for this account.</p></header>
    <div class="grid g2 mt24">
        <a class="card role-choice" href="/register/founder"><partial name="_Icon" model='"pitch"' /><h2>I run a startup</h2><p>Create a startup profile, verify ownership and pitch investors.</p><span>Continue as a founder →</span></a>
        <a class="card role-choice" href="/register/investor"><partial name="_Icon" model='"compass"' /><h2>I invest in startups</h2><p>Discover companies, shortlist opportunities and receive pitches.</p><span>Continue as an investor →</span></a>
    </div><p class="mt24">Already have an account? <a href="/login">Sign in</a></p>
</div></section>
