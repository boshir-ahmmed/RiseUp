@{ ViewData["Title"] = "Join RiseUp"; }
<section class="section" style="padding-top:48px"><div class="container" style="max-width:820px">
    <h1 style="font-size:32px;text-align:center">Join RiseUp</h1><p class="muted" style="text-align:center">Choose one primary role. An account can be a Founder or an Investor, not both.</p>
    <div class="grid g2 mt24">
        <a class="card mk-card card-b" style="color:var(--ink)" href="/register/founder"><span class="badge b-dark">Founder</span><h3 class="mt16">I run a startup</h3><p class="small muted mb0">Create one startup profile, verify ownership, pitch verified investors and publish updates.</p></a>
        <a class="card mk-card card-b" style="color:var(--ink)" href="/register/investor"><span class="badge b-ver">Investor</span><h3 class="mt16">I invest in startups</h3><p class="small muted mb0">Verify your credentials, discover startups, receive pitches and send free invitations.</p></a>
    </div>
</div></section>
