{
  "Logging": { "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning", "Microsoft.EntityFrameworkCore": "Warning" } },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "RiseUp": "Server=(localdb)\\MSSQLLocalDB;Database=RiseUp;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Database": { "Provider": "SqlServer" },
  "Ai": { "Provider": "Sandbox", "SimulateModel1Outage": false, "SimulateModel2Outage": false, "TimeoutSeconds": 8 },
  "Payments": { "Gateway": "Sandbox", "WebhookSecret": "" },
  "Storage": { "RootPath": "App_Data/private" },
  "Mfa": { "AllowDemoCodes": false },
  "Jobs": { "Enabled": true, "IntervalSeconds": 60 },
  "Seed": { "DemoMediaPath": "DemoMedia" }
}
